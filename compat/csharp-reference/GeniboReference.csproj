<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Reference harness: compiles the ORIGINAL, UNMODIFIED OpenJigWare Genibo
    source file against capture stubs (Stubs.cs) and records the exact bytes it
    would write to the Bluetooth serial port / TCP sockets.

    The output (golden JSON) is the compatibility baseline for the Python SDK.
    Nothing here talks to hardware.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <RollForward>Major</RollForward>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS0162;CS0168;CS0169;CS0219;CS0414;CS0649;CS0618;CS0665;SYSLIB0006;CS8981</NoWarn>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <!-- The legacy implementation: verbatim upstream copy in compat/legacy (never edited). -->
    <Compile Include="../legacy/OpenJigWare/COjw_25_Genibo.cs" Link="Legacy/COjw_25_Genibo.cs" />
    <Compile Include="Stubs.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>
</Project>
